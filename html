<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WinLocker Simulation</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
        }
        body, html {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #000;
            font-family: 'Courier New', Courier, monospace;
            color: #fff;
        }

        /* ЭТАП 1: РАБОЧИЙ СТОЛ */
        #desktop {
            display: flex;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle, #1a222d 0%, #0b0f19 100%);
            position: absolute;
            top: 0;
            left: 0;
            padding: 20px;
            flex-direction: column;
            flex-wrap: wrap;
            align-content: flex-end;
            gap: 20px;
            z-index: 10;
        }
        .icon {
            width: 80px;
            height: 90px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            cursor: pointer;
            border: 1px solid transparent;
        }
        .icon:hover {
            background-color: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        .icon-img {
            width: 45px;
            height: 45px;
            background-color: #555;
            border-radius: 5px;
            margin-bottom: 5px;
            position: relative;
        }
        .icon-img.exe { background-color: #b33939; }
        .icon-img.game { background-color: #227093; }
        .icon-img.code { background-color: #218c74; }
        .icon-label {
            font-size: 12px;
            text-shadow: 1px 1px 2px #000;
            word-break: break-all;
        }

        /* ЭТАП 2: ФЕЙК BSOD */
        #bsod {
            display: none;
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            background-color: #000;
            padding: 10% 15%;
            font-size: 20px;
            line-height: 1.6;
            z-index: 20;
        }
        .hidden-line {
            display: none;
            margin-bottom: 15px;
        }

        /* ЭТАП 3: СКАНИРОВАНИЕ */
        #scanning {
            display: none;
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            background-color: #000;
            padding: 40px;
            font-size: 18px;
            z-index: 30;
            overflow: hidden;
        }
        #scan-container {
            max-height: 70%;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }
        .scan-err { color: #ff3838; }
        #crit-msg {
            display: none;
            position: absolute;
            bottom: 10%;
            left: 50%;
            transform: translateX(-50%);
            text-align: center;
        }
        #crit-msg h1 {
            color: #ff3838;
            font-size: 40px;
            margin-bottom: 15px;
            letter-spacing: 2px;
        }

        /* ЭТАП 4: ВИНЛОКЕР */
        #locker {
            display: none;
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            background-color: #050508;
            z-index: 40;
            padding: 50px;
        }
        .locker-grid {
            display: grid;
            grid-template-columns: 1fr 2fr 1fr;
            height: 100%;
            width: 100%;
        }
        .side-panel {
            display: flex;
            flex-direction: column;
            color: #444;
            font-size: 14px;
        }
        .center-panel {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding-top: 40px;
            text-align: center;
        }
        .main-alert {
            color: #ff3838;
            font-size: 38px;
            font-weight: bold;
            margin-bottom: 10px;
            text-transform: uppercase;
        }
        .sub-alert {
            font-size: 18px;
            margin-bottom: 40px;
            color: #ccc;
        }
        .timer-box {
            font-size: 60px;
            font-weight: bold;
            letter-spacing: 3px;
            margin-bottom: 40px;
            border: 2px dashed #ff3838;
            padding: 15px 40px;
            background-color: rgba(255, 56, 56, 0.05);
        }
        .input-area {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 15px;
            width: 320px;
        }
        .key-input {
            width: 100%;
            background-color: #111;
            border: 2px solid #333;
            color: #00ff00;
            padding: 12px;
            font-size: 20px;
            text-align: center;
            font-family: inherit;
            outline: none;
        }
        .key-input:focus { border-color: #ff3838; }
        .btn-unlock {
            width: 100%;
            background-color: #ff3838;
            color: #fff;
            border: none;
            padding: 12px;
            font-size: 16px;
            font-weight: bold;
            font-family: inherit;
            cursor: pointer;
            text-transform: uppercase;
        }
        .btn-unlock:hover { background-color: #cf2121; }
        .wrong-msg {
            color: #ff3838;
            font-weight: bold;
            margin-top: 10px;
            visibility: hidden;
            text-transform: uppercase;
        }
        .attempts {
            margin-top: 10px;
            font-size: 16px;
            color: #aaa;
        }
        .log-panel {
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding-bottom: 20px;
            font-size: 14px;
            color: #00ff00;
            overflow: hidden;
            max-height: 250px;
        }
        .log-line {
            margin-top: 5px;
            white-space: nowrap;
        }

        /* Спецэффект яростной тряски при ошибке */
        .shake {
            animation: shakeAnim 0.15s infinite;
            background-color: #200000 !important;
        }
        @keyframes shakeAnim {
            0% { transform: translate(3px, 5px) rotate(0deg); }
            20% { transform: translate(-5px, -3px) rotate(-1deg); }
            40% { transform: translate(-1px, 3px) rotate(1deg); }
            60% { transform: translate(4px, -2px) rotate(0deg); }
            80% { transform: translate(-2px, 4px) rotate(1deg); }
            100% { transform: translate(2px, -4px) rotate(-1deg); }
        }
        
        .simulation-banner {
            position: absolute;
            top: 5px;
            right: 5px;
            font-size: 10px;
            color: #333;
            z-index: 100;
        }
    </style>
</head>
<body>

    <div class="simulation-banner">SIMULATION PRANK MODE</div>

    <div id="desktop">
        <div class="icon" onclick="startPayload()">
            <div class="icon-img exe"></div>
            <div class="icon-label">photo.png.exe</div>
        </div>
        <div class="icon">
            <div class="icon-img game"></div>
            <div class="icon-label">Minecraft</div>
        </div>
        <div class="icon">
            <div class="icon-img code"></div>
            <div class="icon-label">vzlom.py</div>
        </div>
    </div>

    <div id="bsod">
        <div class="hidden-line" id="b1">Windows has encountered a critical problem.</div>
        <div class="hidden-line" id="b2">Error code: 0x0000007B INACCESSIBLE_BOOT_DEVICE</div>
        <div class="hidden-line" id="b3"></div>
        <div class="hidden-line" id="b4">Attempting MBR repair...</div>
    </div>

    <div id="scanning">
        <div id="scan-container"></div>
        <div id="crit-msg">
            <h1>CRITICAL SYSTEM ERROR</h1>
            <div>Analyzing logs, please wait...</div>
        </div>
    </div>

    <div id="locker">
        <div class="locker-grid">
            <div class="side-panel">
                <div>WinLocker creator - fsoocietyfan</div>
                <div>TG: ???</div>
            </div>
            
            <div class="center-panel">
                <div class="main-alert">All your files have been encrypted</div>
                <div class="sub-alert">To restore your operation system, enter the decryption key.</div>
                
                <div class="timer-box" id="timer">23:59:59</div>
                
                <div class="input-area">
                    <input type="text" id="password-field" class="key-input" placeholder="Enter key..." autocomplete="off">
                    <button class="btn-unlock" onclick="checkPassword()">Unlock Files</button>
                    <div class="wrong-msg" id="wrong-banner">Wrong Decryption Key!</div>
                    <div class="attempts" id="attempts-banner">Attempts remaining: 3</div>
                </div>
            </div>

            <div class="log-panel" id="log-container"></div>
        </div>
    </div>

    <script>
        // Конфигурация правильного ключа
        const CORRECT_KEY = "1234";
        let attemptsLeft = 3;

        // Запуск всей цепочки по клику на photo.png.exe
        function startPayload() {
            // Запрос полноэкранного режима для реализма (работает по клику)
            if (document.documentElement.requestFullscreen) {
                document.documentElement.requestFullscreen();
            }
            
            document.getElementById('desktop').style.display = 'none';
            document.getElementById('bsod').style.display = 'block';
            
            // Поочередный вывод строк BSOD
            setTimeout(() => { document.getElementById('b1').style.display = 'block'; }, 400);
            setTimeout(() => { document.getElementById('b2').style.display = 'block'; }, 1000);
            setTimeout(() => { document.getElementById('b4').style.display = 'block'; }, 1800);
            
            // Переход к этапу 3 (сканирование)
            setTimeout(startScanning, 3500);
        }

        // Логика бегущих секторов
        function startScanning() {
            document.getElementById('bsod').style.display = 'none';
            document.getElementById('scanning').style.display = 'block';
            
            const container = document.getElementById('scan-container');
            let iteration = 0;
            
            let scanInterval = setInterval(() => {
                let sector = (Math.random() * 0xFFFFFF << 0).toString(16).toUpperCase();
                
                let line1 = document.createElement('div');
                line1.innerText = `Scanning Sector 0x${sector.padStart(6, '0')}...`;
                container.appendChild(line1);
                
                let line2 = document.createElement('div');
                line2.className = 'scan-err';
                line2.innerText = `ERROR: Disk Timeout`;
                container.appendChild(line2);
                
                // Автоскролл логов вниз
                container.scrollTop = container.scrollHeight;
                
                iteration++;
                if (iteration >= 15) {
                    clearInterval(scanInterval);
                    document.getElementById('crit-msg').style.display = 'block';
                    // Переход к финальному окну вымогателя
                    setTimeout(initLocker, 2500);
                }
            }, 180);
        }

        // Инициализация финального экрана
        function initLocker() {
            document.getElementById('scanning').style.display = 'none';
            document.getElementById('locker').style.display = 'block';
            
            startCountdown();
            startFileLogs();
        }

        // Обратный отсчет таймера (24 часа)
        function startCountdown() {
            let totalSeconds = 24 * 3600;
            const timerEl = document.getElementById('timer');
            
            setInterval(() => {
                totalSeconds--;
                if (totalSeconds < 0) totalSeconds = 0;
                
                let hrs = Math.floor(totalSeconds / 3600);
                let mins = Math.floor((totalSeconds % 3600) / 60);
                let secs = totalSeconds % 60;
                
                timerEl.innerText = 
                    `${String(hrs).padStart(2, '0')}:${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
            }, 1000);
        }

        // Бегущие строки шифрования файлов в углу
        function startFileLogs() {
            const container = document.getElementById('log-container');
            const fakePaths = [
                "C:\\Users\\user\\Desktop\\vzlom.py",
                "C:\\Users\\user\\Documents\\photo_secret.png",
                "C:\\Users\\user\\Desktop\\games\\Standoff2\\config.cfg",
                "C:\\Users\\user\\Downloads\\cheat_menu.exe",
                "C:\\Users\\user\\Pictures\\avatar.jpg",
                "C:\\Users\\user\\AppData\\Local\\Temp\\system_log.txt"
            ];
            let idx = 0;
            
            setInterval(() => {
                let currentPath = fakePaths[idx % fakePaths.length];
                let line = document.createElement('div');
                line.className = 'log-line';
                line.innerText = `[logs] Encrypting: ${currentPath}`;
                container.appendChild(line);
                
                if (container.children.length > 7) {
                    container.removeChild(container.children[0]);
                }
                idx++;
            }, 400);
        }

        // Проверка пароля и "вирусная" реакция при ошибке
        function checkPassword() {
            const inputField = document.getElementById('password-field');
            const wrongBanner = document.getElementById('wrong-banner');
            const attemptsBanner = document.getElementById('attempts-banner');
            const lockerWindow = document.getElementById('locker');
            
            if (inputField.value === CORRECT_KEY) {
                // Если пароль верный - всё закрывается
                alert("ACCESS GRANTED. SYSTEM UNLOCKED.");
                location.reload(); 
            } else {
                // "Вирусный" эффект: включаем жесткую тряску и красную вспышку
                attemptsLeft--;
                if (attemptsLeft < 0) attemptsLeft = 0;
                
                attemptsBanner.innerText = `Attempts remaining: ${attemptsLeft}`;
                wrongBanner.style.visibility = 'visible';
                inputField.value = "";
                
                // Добавляем класс тряски
                lockerWindow.classList.add('shake');
                
                // Звуковой сигнал ошибки встроенными средствами браузера
                try {
                    let context = new (window.AudioContext || window.webkitAudioContext)();
                    let osc = context.createOscillator();
                    osc.type = "sawtooth";
                    osc.frequency.setValueAtTime(120, context.currentTime); // Низкий страшный звук
                    osc.connect(context.destination);
                    osc.start();
                    osc.stop(context.currentTime + 0.4);
                } catch(e) {}

                // Убираем тряску через полсекунды
                setTimeout(() => {
                    lockerWindow.classList.remove('shake');
                }, 500);
            }
        }
    </script>
</body>
</html>